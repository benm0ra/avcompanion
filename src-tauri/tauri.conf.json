{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVcompanion",
  "version": "0.1.0",
  "identifier": "com.avcompanion.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AVcompanion",
        "width": 440,
        "height": 760,
        "resizable": true,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "vendor/vbcable/": "vbcable/"
    }
  }
}
